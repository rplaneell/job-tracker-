# Copy this file to .env and fill in the values. Never commit .env.
# Only variables starting with VITE_ are sent to the browser, so never put a secret in them.

# Supabase (leave empty until a Supabase project exists).
# The project URL and the publishable key are safe to expose in the browser.
# The service role key must NEVER be placed in this project's browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
